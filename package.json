{
  "name": "dungeon-dm",
  "private": true,
  "version": "0.1.0",
  "description": "Two-window dungeon crawl map tool for the DM and the players",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "app:build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --bundles app",
    "test:rust": "cd src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-http": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "immer": "^11.1.18",
    "konva": "^10.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "yaml": "^2.9.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
