{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the DM and player windows",
  "windows": [
    "dm",
    "player"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.spotify.com/*"
        },
        {
          "url": "https://accounts.spotify.com/*"
        }
      ]
    }
  ]
}
